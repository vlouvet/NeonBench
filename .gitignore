# Build artifacts
/dist/
/web/dist/
!/web/dist/.gitkeep
/bin/

# Go
*.test
*.out
coverage.*

# Vectorize golden test failure artifacts (SVG dumps for reviewer triage,
# regenerated on every failing run — see internal/vectorize/integration_test.go)
internal/vectorize/testdata/goldens/_failures/

# Stray test inputs left in the repo root (PNG/JPG/SVG/screen recordings)
/*.png
/*.jpg
/*.jpeg
/*.svg
/*.mov
/*.mp4
/*.webm

# Node
/web/node_modules/
.npm

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Claude Agent SDK scratch (worktrees for parallel sub-agents). See CLAUDE.md.
/.claude/

# Hershey font script's download cache (rebuilt by scripts/build-hershey-font.mjs)
/.hershey-cache/

# Local dev data (when running outside the per-OS app data dir)
*.db
*.db-journal
*.db-wal
*.db-shm

# Neon trade reference PDFs (kept locally; rules extracted to docs/neon-rules/)
/docs/**/*.pdf
/docs/private-sources/

# Neon Techniques (Miller/Strattman 1997) — Kindle page screenshots (~190 PNGs)
# Reference material kept locally; extracted rules go in docs/neon-rules/
/docs/shot_*

# Playwright MCP scratch output (screenshots/snapshots during dev)
.playwright-mcp/
